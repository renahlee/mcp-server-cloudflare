{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "src/sql-api.app.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": ["nodejs_compat"],
	"name": "mcp-cloudflare-sql-api-dev",
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.1
		}
	},
	"kv_namespaces": [{ "binding": "OAUTH_KV", "id": "DEV_KV" }],
	"vars": {
		"ENVIRONMENT": "development",
		"MCP_SERVER_NAME": "sql-api",
		"MCP_SERVER_VERSION": "0.1.0",
		"CLOUDFLARE_CLIENT_ID": "<PLACEHOLDER>",
		"CLOUDFLARE_CLIENT_SECRET": "<PLACEHOLDER>"
	},
	"dev": { "port": 8987 },
	"workers_dev": false,
	"preview_urls": false,
	"analytics_engine_datasets": [{ "binding": "MCP_METRICS", "dataset": "mcp-metrics-dev" }],
	"env": {
		"staging": {
			"name": "mcp-cloudflare-sql-api-staging",
			"account_id": "6702657b6aa048cf3081ff3ff3c9c52f",
			"routes": [{ "pattern": "sql-staging.mcp.cloudflare.com", "custom_domain": true }],
			"vars": {
				"ENVIRONMENT": "staging",
				"MCP_SERVER_NAME": "sql-api-staging",
				"MCP_SERVER_VERSION": "1.0.0"
			},
			"analytics_engine_datasets": [
				{
					"binding": "MCP_METRICS",
					"dataset": "mcp-metrics-staging"
				}
			]
		},
		"production": {
			"name": "mcp-cloudflare-sql-api-production",
			"account_id": "6702657b6aa048cf3081ff3ff3c9c52f",
			"routes": [{ "pattern": "sql.mcp.cloudflare.com", "custom_domain": true }],
			"vars": {
				"ENVIRONMENT": "production",
				"MCP_SERVER_NAME": "sql-api",
				"MCP_SERVER_VERSION": "1.0.0"
			},
			"analytics_engine_datasets": [
				{
					"binding": "MCP_METRICS",
					"dataset": "mcp-metrics-production"
				}
			]
		}
	}
}
